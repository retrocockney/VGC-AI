from transformers import AutoModelForCausalLM, AutoTokenizer\
import torch\
import gradio as gr\
\
# Load AI model\
model_name = "gpt2"  # small free model, can replace with bigger later\
tokenizer = AutoTokenizer.from_pretrained(model_name)\
model = AutoModelForCausalLM.from_pretrained(model_name)\
\
# Function to generate strategies\
def generate_strategy(pokemon):\
    prompt = f"Give a competitive Pok\'e9mon VGC strategy for \{pokemon\} with ability, moves, item, and EVs."\
    inputs = tokenizer(prompt, return_tensors="pt")\
    outputs = model.generate(**inputs, max_length=150, do_sample=True, top_p=0.9, temperature=0.7)\
    response = tokenizer.decode(outputs[0], skip_special_tokens=True)\
    return response\
\
# Gradio interface\
iface = gr.Interface(\
    fn=generate_strategy,\
    inputs="text",\
    outputs="text",\
    title="VGC AI Strategy Bot",\
    description="Type a Pok\'e9mon name and get AI-generated VGC strategies."\
)\
\
iface.launch()\
}